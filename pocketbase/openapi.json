              "XCG",
              "XOF",
              "XPF",
              "YER",
              "ZAR",
              "ZMW",
              "ZWG"
            ],
            "description": "Must be enabled in the user account. Defaults to the user main currency."
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "description": "An active category belonging to the user; case-insensitive. Defaults to active Other, otherwise the first active category. Responses use the configured casing."
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "description": "Defaults to server time; include Z or a timezone offset when supplied."
          },
          "card": {
            "type": "string",
            "maxLength": 80
          },
          "notes": {
            "type": "string",
            "maxLength": 2000
          },
          "amount_minor": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99999999999,
            "description": "Positive integer currency minor units. SGD 6.50 = 650, JPY 1000 = 1000, KWD 1.234 = 1234. If amount_cents is also present both must agree."
          }
        },
        "anyOf": [
          {
            "required": [
              "amount_minor"
            ]
          },
          {
            "required": [
              "amount_cents"
            ]
          }
        ]
      },
      "Expense": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ExpenseInput"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "user": {
                "type": "string"
              },
              "source": {
                "type": "string",
                "enum": [
                  "manual",
                  "api"
                ]
              },
              "created": {
                "type": "string"
              },
              "updated": {
                "type": "string"
              },
              "replay": {
                "type": "boolean"
              },
              "amount_cents": {
                "type": "integer",
                "description": "Native compatibility field containing the same currency minor-unit value as amount_minor, for every currency."
              },
              "amount_minor": {
                "type": "integer",
                "minimum": 1,
                "maximum": 99999999999
              }
            }
          }
        ]
      }
    }
  }
}
